# Copy this file to .env and fill in your webhook
GCHAT_WEBHOOK_URL=https://chat.googleapis.com/v1/spaces/XXXX/messages?key=XXXX&token=XXXX

ENVIZOM_URL=https://envizom.oizom.com/
CHECK_INTERVAL=60      # seconds between checks
PAGE_TIMEOUT=45        # seconds to wait for page load
RETRY_DELAY=15         # re-check once before alerting (0 = alert on first failure)
REMIND_EVERY=1800      # re-alert every 30 min while still down (0 = never)
# EXPECT_SELECTOR=input[type=password]   # optional: element that must be visible
